TEMPERATURE=0.1
MODEL_NAME=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
TOP_K_RESULTS=5
CRISIS_KEYWORDS=suicide,self-harm,kill myself,end my life,hurt myself,overdose,not worth living
